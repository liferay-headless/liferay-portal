@component-name = "portal-headless"
definition {

	property custom.properties = "feature.flag.LPS-153324=true${line.separator}feature.flag.LPS-162964=true${line.separator}feature.flag.LPS-162966=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Object";
	property testray.main.component.name = "Headless";

	setUp {
		TestCase.setUpPortalInstanceNoSelenium();

		task ("Given a Foundation object") {
			ObjectDefinitionAPI.setUpGlobalFoundationId();
		}

		task ("Given an Organization object") {
			ObjectDefinitionAPI.setUpGlobalOrganizationId();
		}

		task ("Given manyToMany relationship usersFoundations created") {
			UserAccountAPI.setUpGlobalObjectUserAccountId();

			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "cascade",
				en_US_label = "usersFoundations",
				name = "usersFoundations",
				objectDefinitionId1 = "${staticObjectUserAccountId}",
				objectDefinitionId2 = "${staticFoundationId}",
				type = "manyToMany");
		}

		task ("Given oneToMany relationship userOrganizations created") {
			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "cascade",
				en_US_label = "userOrganizations",
				name = "userOrganizations",
				objectDefinitionId1 = "${staticObjectUserAccountId}",
				objectDefinitionId2 = "${staticOrganizationId}",
				type = "oneToMany");
		}

		task ("Given object entries created") {
			ObjectDefinitionAPI.setUpGlobalFoundationEntriesIds();

			ObjectDefinitionAPI.setUpGlobalOrganizationEntriesIds();
		}

		task ("Given two userAccount entries created") {
			UserAccountAPI.setUpGlobalUserAccountOneId(
				alternateName = "user1",
				emailAddress = "user1@liferay.com",
				familyName = "userfn1",
				givenName = "usergn1");

			UserAccountAPI.setUpGlobalUserAccountTwoId(
				alternateName = "user2",
				emailAddress = "user2@liferay.com",
				familyName = "userfn2",
				givenName = "usergn2");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			for (var objectName : list "Foundation,Organization") {
				ObjectAdmin.deleteObjectViaAPI(objectName = "${objectName}");
			}

			for (var userId : list "${staticUserAccountOneId},${staticUserAccountTwoId}") {
				JSONUser.deleteUserByUserId(userId = "${userId}");
			}
		}
	}

	@disable-webdriver = "true"
	@ignore = "true"
	@priority = "3"
	@refactorneeded
	test CanGetRelationshipDetailsThroughRelationshipEndpointWithoutRelatedEntries {
		property portal.acceptance = "true";

		task ("When I call userAccount object GET endpoint with {userAccountId}/usersFoundations") {
			UserAccountAPI.getRelationshipByUserAccountId(
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountOneId}");
		}

		task ("Then I receive a correct response with GET endpoint {userAccount}/usersFoundations") {
			UserAccountAPI.assertResponseNotIncludeDetailsOfDeletedObjectEntry(
				customObjectEntryId = "${staticFoundationAbcId}",
				expectedValue = "[]",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountOneId}");
		}
	}

	@disable-webdriver = "true"
	@priority = "3"
	test CanNotGetDetailsAfterRelationshipIsDeleted {
		property portal.acceptance = "true";

		task ("And Given I relate the organization entry with the userAccount entry through the userAccount PUT endpoint") {
			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticOrganizationIjkId}",
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");
		}

		task ("When deleting the relationship") {
			ObjectDefinitionAPI.deleteRelationship(
				name = "User",
				relationshipName = "userOrganizations");
		}

		task ("Then the GET endpoint {userAccountId}/userOrganizations is no longer available") {
			var response = UserAccountAPI.getRelationshipByUserAccountId(
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");

			ObjectDefinitionAPI.assertStatusInResponse(
				expectedValue = "NOT_FOUND",
				responseToParse = "${response}");
		}
	}

	@disable-webdriver = "true"
	@priority = "4"
	test CanReturnDetailsInManyToManyRelationship {
		property portal.acceptance = "true";

		task ("When I relate the foundation entry with the userAccount entry through the userAccount PUT endpoint") {
			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticFoundationAbcId}",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountOneId}");
		}

		task ("Then receiving correct information about the related objects in the userAccountGET endpoint {userAccountId}/usersFoundations") {
			UserAccountAPI.assertResponseHasCorrectRelatedEntryName(
				customObjectEntryId = "${staticFoundationAbcId}",
				expectedValue = "Foundation Abc",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountOneId}");
		}
	}

	@disable-webdriver = "true"
	@priority = "4"
	test CanReturnDetailsInManyToManyRelationshipAfterObjectEntryDeletion {
		property portal.acceptance = "true";

		task ("And Given I relate the foundation entry with the userAccount entry through the userAccount PUT endpoint") {
			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticFoundationAbcId}",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountOneId}");

			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticFoundationEfgId}",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountTwoId}");
		}

		task ("When deleting one of the foundation entries") {
			ObjectDefinitionAPI.deleteObjectEntry(
				en_US_plural_label = "foundations",
				objectEntryId = "${staticFoundationAbcId}");
		}

		task ("Then I receive a correct response with GET endpoint {userAccount}/usersFoundations") {
			UserAccountAPI.assertResponseNotIncludeDetailsOfDeletedObjectEntry(
				expectedValue = "[]",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountOneId}");

			UserAccountAPI.assertResponseHasCorrectRelatedEntryName(
				customObjectEntryId = "${staticFoundationEfgId}",
				expectedValue = "Foundation Efg",
				relationshipName = "usersFoundations",
				userAccountId = "${staticUserAccountTwoId}");
		}
	}

	@disable-webdriver = "true"
	@priority = "4"
	test CanReturnDetailsInOneToManyRelationship {
		property portal.acceptance = "true";

		task ("When I relate the organization entry with the userAccount entry through the userAccount PUT endpoint") {
			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticOrganizationIjkId}",
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");
		}

		task ("Then receiving correct information about the related objects in the userAccountGET endpoint {userAccountId}/userOrganizations") {
			UserAccountAPI.assertResponseHasCorrectRelatedEntryName(
				customObjectEntryId = "${staticOrganizationIjkId}",
				expectedValue = "Organization Ijk",
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");
		}
	}

	@disable-webdriver = "true"
	@priority = "4"
	test CanReturnDetailsInOneToManyRelationshipAfterObjectEntryDeletion {
		property portal.acceptance = "true";

		task ("And Given I relate the secondFoundation entry with the userAccount entry through the userAccount PUT endpoint") {
			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticOrganizationIjkId}",
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");

			UserAccountAPI.relateObjectEntries(
				customObjectId = "${staticOrganizationLmnId}",
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");
		}

		task ("When deleting one of the foundation entries") {
			ObjectDefinitionAPI.deleteObjectEntry(
				en_US_plural_label = "organizations",
				objectEntryId = "${staticOrganizationIjkId}");
		}

		task ("Then I receive a correct response with GET endpoint {userAccount}/userSecondFoundations") {
			UserAccountAPI.assertResponseHasCorrectRelatedEntryName(
				customObjectEntryId = "${staticOrganizationLmnId}",
				expectedValue = "Organization Lmn",
				relationshipName = "userOrganizations",
				userAccountId = "${staticUserAccountOneId}");
		}
	}

}