				en_US_plural_label = "campuses",
				name = "Liferay");
		}

		task ("Given lecturer entry created") {
			var lecturerId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "lecturers",
				name = "Liferay Foundations");
		}

		task ("When I relate lecturer entry with campus entry through campuses PUT endpoint") {
			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");
		}

		task ("Then the lecturer is related to the campus in lecturers GET endpoint with nestedFields=campusesLecturers") {
			var getObjectsWithNestedFieldReponse = ObjectDefinitionAPI.getObjectsWithNestedField(
				nestedField = "campusesLecturers",
				objects = "lecturers");

			ObjectDefinitionAPI.assertNestedFieldDetail(
				expectedValue = "${campusId}",
				getObjectsWithNestedFieldReponse = "${getObjectsWithNestedFieldReponse}",
				nestedField = "campusesLecturers",
				objectEntryId = "${lecturerId}",
				objectField = "id");

			ObjectDefinitionAPI.assertNestedFieldDetail(
				expectedValue = "Liferay",
				getObjectsWithNestedFieldReponse = "${getObjectsWithNestedFieldReponse}",
				nestedField = "campusesLecturers",
				objectEntryId = "${lecturerId}",
				objectField = "name");
		}
