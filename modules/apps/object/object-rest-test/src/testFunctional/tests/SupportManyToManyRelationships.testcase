@component-name = "portal-headless"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Object";
	property testray.main.component.name = "Headless";

	setUp {
		TestCase.setUpPortalInstanceNoSelenium();

		SupportManyToManyRelationships.setUpGlobalLecturerObjectId();

		SupportManyToManyRelationships.setUpGlobalCampusObjectId();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			for (var objectName : list "Campus,Lecturer,Room") {
				ObjectAdmin.deleteObjectViaAPI(objectName = "${objectName}");
			}
		}
	}

	@disable-webdriver = "true"
	@priority = "4"
	test CanDeleteObjectEntryWithDisassociateDeletionTypeRelationshipCreated_1 {
		property portal.acceptance = "true";
		property test.name.skip.portal.instance = "SupportManyToManyRelationships#CanDeleteObjectEntryWithDisassociateDeletionTypeRelationshipCreated_1";

		task ("Given manyToMany relationship campusesLecturers with deletionType Disassociate created") {
			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "disassociate",
				en_US_label = "campusesLecturers",
				name = "campusesLecturers",
				objectDefinitionId1 = "${staticCampusObjectId}",
				objectDefinitionId2 = "${staticLecturerObjectId}",
				type = "manyToMany");
		}

		task ("Given three campus entries created") {
			var campusId1 = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "West Campus");
			var campusId2 = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "South Campus");
			var campusId3 = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "North Campus");
		}

		task ("Given lecturer entry created") {
			var lecturerId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "lecturers",
				name = "Jane Doe");
		}

		task ("When I relate lecturer entry with all three campuses through campuses PUT endpoint") {
			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId1}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");

			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId2}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");

			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId3}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");
		}

		task ("When deleting lecturer entry") {
			var response = ObjectDefinitionAPI.deleteObjectEntry(
				en_US_plural_label = "lecturers",
				objectEntryId = "${lecturerId}");
		}

		task ("Then the lecturer does not appear in any of the campuses in campuses GET endpoint with nestedFields=campusesLecturers") {
			var responseToParse = ObjectDefinitionAPI.getObjectsWithNestedField(
				nestedField = "campusesLecturers",
				objects = "campuses");

			ObjectDefinitionAPI.assertResponseNotIncludeDetailsOfDeletedObject(
				expectedValue = "[],[],[]",
				responseToParse = "${responseToParse}");
		}
	}

	@disable-webdriver = "true"
	@priority = "4"
	test CanDeleteObjectEntryWithDisassociateDeletionTypeRelationshipCreated_2 {
		property portal.acceptance = "true";
		property test.name.skip.portal.instance = "SupportManyToManyRelationships#CanDeleteObjectEntryWithDisassociateDeletionTypeRelationshipCreated_2";

		task ("Given manyToMany relationship campusesLecturers with deletionType Disassociate created") {
			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "disassociate",
				en_US_label = "campusesLecturers",
				name = "campusesLecturers",
				objectDefinitionId1 = "${staticCampusObjectId}",
				objectDefinitionId2 = "${staticLecturerObjectId}",
				type = "manyToMany");
		}

		task ("Given three campus entries created") {
			var campusId1 = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "Liferay First Campus");
			var campusId2 = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "Liferay Second Campus");
			var campusId3 = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "Liferay Third Campus");
		}

		task ("Given lecturer entry created") {
			var lecturerId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "lecturers",
				name = "Liferay Foundations");
		}

		task ("When I relate lecturer entry with all three campuses through campuses PUT endpoint") {
			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId1}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");

			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId2}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");

			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId3}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");
		}

		task ("When deleting one of the campuses") {
			var response = ObjectDefinitionAPI.deleteObjectEntry(
				en_US_plural_label = "campuses",
				objectEntryId = "${campusId1}");
		}

		task ("Then receiving correct information about the related objects in lecturers GET endpoint with nestedFields=campusesLecturers") {
			var responseToParse = ObjectDefinitionAPI.getObjectsWithNestedField(
				nestedField = "campusesLecturers",
				objects = "lecturers");

			ObjectDefinitionAPI.assertNestedFieldDetail(
				expectedValue = "Liferay Second Campus,Liferay Third Campus",
				getObjectsWithNestedFieldReponse = "${responseToParse}",
				nestedField = "campusesLecturers",
				objectEntryId = "${lecturerId}",
				objectField = "name");
		}
	}

	@disable-webdriver = "true"
	@priority = "5"
	test CanGetFirstObjectEntiresRelatedToSecondObjectByManyToMany {
		property portal.acceptance = "true";
		property test.name.skip.portal.instance = "SupportManyToManyRelationships#CanGetFirstObjectEntiresRelatedToSecondObjectByManyToMany";

		task ("Given manyToMany relationship campusesLecturers created") {
			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "cascade",
				en_US_label = "campusesLecturers",
				name = "campusesLecturers",
				objectDefinitionId1 = "${staticCampusObjectId}",
				objectDefinitionId2 = "${staticLecturerObjectId}",
				type = "manyToMany");
		}

		task ("Given campus entry created") {
			var campusId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "Liferay Campus");
		}

		task ("Given lecturer entry created") {
			var lecturerId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "lecturers",
				name = "Liferay Foundations");
		}

		task ("And Given lecturer entry related to the campus entry created") {
			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "campuses",
				objectEntry1 = "${campusId}",
				objectEntry2 = "${lecturerId}",
				relationshipName = "campusesLecturers");
		}

		task ("When I call campuses GET endpoint with {campusId}/campusesLecturers") {
			var responseToParse = ObjectDefinitionAPI.getObjectEntryRelation(
				en_US_plural_label = "campuses",
				objectId = "${campusId}",
				relationshipName = "campusesLecturers");
		}

		task ("Then I receive the correct information about the lecturers related to it") {
			ObjectDefinitionAPI.assertResponseHasCorrectObjectEntryName(
				expectedValue = "Liferay Foundations",
				objectEntryId = "${lecturerId}",
				responseToParse = "${responseToParse}");
		}
	}

	@disable-webdriver = "true"
	@priority = "5"
	test CanGetManyToManyRelationshipDetailsAsNestedFields_1 {
		property portal.acceptance = "true";
		property test.name.skip.portal.instance = "SupportManyToManyRelationships#CanGetManyToManyRelationshipDetailsAsNestedFields_1";

