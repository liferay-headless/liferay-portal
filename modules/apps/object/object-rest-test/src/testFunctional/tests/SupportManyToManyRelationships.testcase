	@disable-webdriver = "true"
	@priority = "4"
	test CanGetMultipleManyToManyRelationshipDetailsAsNestedFields {
		property portal.acceptance = "true";
		property test.name.skip.portal.instance = "SupportManyToManyRelationships#CanGetMultipleManyToManyRelationshipDetailsAsNestedFields";

		task ("Given active room object definition created") {
			var objectDefinitionId3 = ObjectDefinitionAPI.createAndPublishObjectDefinition(
				en_US_label = "room",
				en_US_plural_label = "rooms",
				name = "Room",
				requiredStringFieldName = "name");
		}

		task ("Given manyToMany relationship campusesLecturers created") {
			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "cascade",
				en_US_label = "campusesLecturers",
				name = "campusesLecturers",
				objectDefinitionId1 = "${staticCampusObjectId}",
				objectDefinitionId2 = "${staticLecturerObjectId}",
				type = "manyToMany");
		}

		task ("Given manyToMany relationship campusesRooms created") {
			var objectDefinitionId2 = JSONObject.getObjectId(objectName = "Room");

			var relationshipName = ObjectDefinitionAPI.createRelationship(
				deletionType = "cascade",
				en_US_label = "campusesRooms",
				name = "campusesRooms",
				objectDefinitionId1 = "${staticCampusObjectId}",
				objectDefinitionId2 = "${objectDefinitionId2}",
				type = "manyToMany");
		}

		task ("Given campus entry created") {
			var campusId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "campuses",
				name = "Liferay Campus");
		}

		task ("Given lecturer entry created") {
			var lecturerId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "lecturers",
				name = "Liferay Foundations");
		}

		task ("Given room entry created") {
			var roomId = ObjectDefinitionAPI.createObjectEntryWithName(
				en_US_plural_label = "rooms",
				name = "Liferay Room");
		}

		task ("Given I relate lecturer entry with campus entry through lecturers PUT endpoint") {
			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "lecturers",
				objectEntry1 = "${lecturerId}",
				objectEntry2 = "${campusId}",
				relationshipName = "campusesLecturers");
		}

		task ("Given I relate room entry with campus entry through rooms PUT endpoint") {
			ObjectDefinitionAPI.relateObjectEntries(
				en_US_plural_label = "rooms",
				objectEntry1 = "${roomId}",
				objectEntry2 = "${campusId}",
				relationshipName = "campusesRooms");
		}

		task ("When I call campuses GET endpoint with nestedFields=campusesLecturers,campusesRooms") {
			var getObjectsWithNestedFieldReponse = ObjectDefinitionAPI.getObjectsWithNestedField(
				nestedField = "campusesLecturers,campusesRooms",
