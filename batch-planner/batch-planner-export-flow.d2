Export Flow Interactions: Batch Planner Interaction With Batch Engine {
  shape: sequence_diagram
  gui: Batch Planner React UI
  beBroker: Batch Engine Broker
  beETR: Export Task Resource
  beETLS: Batch Engine Export Task Local Service

  gui -> beBroker.ack: submit

  programmaticaly POST to batch engine: {
    beBroker -> beETR: POST \nusing ERC
    headless module processes call: {
      beETR -> beETLS.ack: create\ntask record
      beETLS.ack -> beETR: created\ntask waits for executor
    }
    beETR -> beBroker: 203 CREATED
  }

  beBroker.ack -> gui: done

  GET using ERC from headless batch engine: {
    gui -> beETR: GET CONTENT
    beETR -> gui: content
  }
}